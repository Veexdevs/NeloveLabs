# Never expose these values with NEXT_PUBLIC_. Configure them only on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional voice used for a first provider connection. Provide only a voice you are licensed to use.
ELEVENLABS_DEFAULT_VOICE_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional generation quota configuration
STARTER_CREDITS=1000
